#!/bin/sh
set -eu

STATE_DIR="${TIC80CTL_STATE_DIR:-$PWD/.local/tic80ctl}"
PID_FILE="$STATE_DIR/pid"
WRITER_PID_FILE="$STATE_DIR/writer.pid"
REQ_PIPE="$STATE_DIR/req.pipe"
OUT_LOG="$STATE_DIR/out.jsonl"
ERR_LOG="$STATE_DIR/err.log"
CWD_FILE="$STATE_DIR/cwd"
MODE_FILE="$STATE_DIR/mode"
BIN_FILE="$STATE_DIR/bin"
JSON_OUTPUT=0

consume_json_flag() {
  if [ "${1:-}" = "--json" ]; then
    JSON_OUTPUT=1
    return 0
  fi
  return 1
}

usage() {
  cat <<'EOF'
usage: tic80ctl [--json] <command> [args...]

commands:
  start [cart]
  status
  stop
  cmd "<tic80 command>"
  load <cart>
  run
  eval "<expr>"
  screenshot [path]
  playtest --script-file <file> [--timeout <seconds>] [--input-overlay|--no-input-overlay]
EOF
}

json_escape() {
  awk 'BEGIN{ORS=""}
  {
    if(NR>1) printf "\\n";
    gsub(/\\/,"\\\\");
    gsub(/"/,"\\\"");
    gsub(/\t/,"\\t");
    gsub(/\r/,"\\r");
    print;
  }'
}

extract_json_text() {
  awk '
  function find_text(line,    pos,i,c,esc,out) {
    pos = index(line, "\"text\":\"");
    if (!pos) return "";
    i = pos + 8;
    esc = 0;
    out = "";
    for (; i <= length(line); i++) {
      c = substr(line, i, 1);
      if (esc) {
        if (c == "n") out = out "\n";
        else if (c == "t") out = out "\t";
        else if (c == "r") out = out "\r";
        else out = out c;
        esc = 0;
      } else if (c == "\\") esc = 1;
      else if (c == "\"") break;
      else out = out c;
    }
    return out;
  }
  { print find_text($0) }'
}

session_alive() {
  [ -f "$PID_FILE" ] || return 1
  PID="$(cat "$PID_FILE" 2>/dev/null || true)"
  [ -n "$PID" ] || return 1
  kill -0 "$PID" 2>/dev/null
}

ensure_state_dir() {
  mkdir -p "$STATE_DIR"
}

default_bin() {
  if [ -n "${TIC80CTL_BIN:-}" ]; then
    printf '%s\n' "$TIC80CTL_BIN"
  elif [ -x "./build/bin/tic80" ]; then
    printf '%s\n' "./build/bin/tic80"
  else
    printf '%s\n' "tic80"
  fi
}

start_process() {
  MODE="$1"
  BIN="$2"
  CART="${3:-}"

  rm -f "$REQ_PIPE"
  mkfifo "$REQ_PIPE"
  : > "$OUT_LOG"
  : > "$ERR_LOG"
  tail -f /dev/null > "$REQ_PIPE" &
  WRITER_PID=$!
  printf '%s\n' "$WRITER_PID" > "$WRITER_PID_FILE"

  if [ "$MODE" = "plain" ]; then
    if [ -n "$CART" ]; then
      "$BIN" "$CART" --mcp --fs . < "$REQ_PIPE" > "$OUT_LOG" 2> "$ERR_LOG" &
    else
      "$BIN" --mcp --fs . < "$REQ_PIPE" > "$OUT_LOG" 2> "$ERR_LOG" &
    fi
  else
    if [ -n "$CART" ]; then
      xvfb-run --auto-servernum "$BIN" "$CART" --skip --soft --mcp --fs . < "$REQ_PIPE" > "$OUT_LOG" 2> "$ERR_LOG" &
    else
      xvfb-run --auto-servernum "$BIN" --skip --soft --mcp --fs . < "$REQ_PIPE" > "$OUT_LOG" 2> "$ERR_LOG" &
    fi
  fi

  PID=$!
  printf '%s\n' "$PID" > "$PID_FILE"
  printf '%s\n' "$PWD" > "$CWD_FILE"
  printf '%s\n' "$MODE" > "$MODE_FILE"
  printf '%s\n' "$BIN" > "$BIN_FILE"
}

wait_for_ready() {
  ID="$$$(date +%s)"
  REQUEST="{\"jsonrpc\":\"2.0\",\"id\":$ID,\"method\":\"initialize\",\"params\":{\"protocolVersion\":\"2025-03-26\",\"capabilities\":{}}}"
  BEFORE_LINES=0
  if [ -f "$OUT_LOG" ]; then
    BEFORE_LINES="$(wc -l < "$OUT_LOG" 2>/dev/null || printf '0')"
  fi
  printf '%s\n' "$REQUEST" > "$REQ_PIPE"

  COUNT=0
  while [ "$COUNT" -lt 50 ]; do
    if ! session_alive; then
      return 1
    fi
    LINE="$(awk -v start="$((BEFORE_LINES + 1))" -v id="$ID" 'NR >= start && index($0, "\"id\":" id) {print; exit}' "$OUT_LOG" 2>/dev/null || true)"
    if [ -n "$LINE" ]; then
      return 0
    fi
    COUNT=$((COUNT + 1))
    sleep 0.1
  done

  return 1
}

start_session() {
  CART="${1:-}"
  if session_alive; then
    if [ "$JSON_OUTPUT" -eq 1 ]; then
      printf '{"running":true,"pid":%s,"cwd":"%s","mode":"%s"}\n' "$(cat "$PID_FILE")" "$(cat "$CWD_FILE")" "$(cat "$MODE_FILE" 2>/dev/null || printf '')"
    else
      printf 'tic80ctl: session already running (pid=%s, mode=%s)\n' "$(cat "$PID_FILE")" "$(cat "$MODE_FILE" 2>/dev/null || printf unknown)"
    fi
    return 0
  fi

  ensure_state_dir
  BIN="$(default_bin)"

  if [ -n "${DISPLAY:-}" ]; then
    if start_process plain "$BIN" "$CART" && wait_for_ready; then
      :
    else
      stop_session >/dev/null 2>&1 || true
      start_process xvfb "$BIN" "$CART"
      wait_for_ready
    fi
  else
    start_process xvfb "$BIN" "$CART"
    wait_for_ready
  fi

  if [ "$JSON_OUTPUT" -eq 1 ]; then
    printf '{"running":true,"pid":%s,"cwd":"%s","mode":"%s","bin":"%s"}\n' \
      "$(cat "$PID_FILE")" "$(cat "$CWD_FILE")" "$(cat "$MODE_FILE")" "$(cat "$BIN_FILE")"
  else
    printf 'started tic80ctl session (pid=%s, mode=%s)\n' "$(cat "$PID_FILE")" "$(cat "$MODE_FILE")"
  fi
}

status_session() {
  if session_alive; then
    if [ "$JSON_OUTPUT" -eq 1 ]; then
      printf '{"running":true,"pid":%s,"cwd":"%s","mode":"%s","bin":"%s","stdout":"%s","stderr":"%s"}\n' \
        "$(cat "$PID_FILE")" "$(cat "$CWD_FILE")" "$(cat "$MODE_FILE" 2>/dev/null || printf '')" \
        "$(cat "$BIN_FILE" 2>/dev/null || printf '')" "$OUT_LOG" "$ERR_LOG"
    else
      printf 'running pid=%s mode=%s cwd=%s\n' "$(cat "$PID_FILE")" "$(cat "$MODE_FILE" 2>/dev/null || printf unknown)" "$(cat "$CWD_FILE" 2>/dev/null || printf "$PWD")"
      printf 'stdout=%s\nstderr=%s\n' "$OUT_LOG" "$ERR_LOG"
    fi
  else
    if [ "$JSON_OUTPUT" -eq 1 ]; then
      printf '{"running":false}\n'
    else
      printf 'tic80ctl: no active session\n'
    fi
    return 1
  fi
}

stop_session() {
  if ! session_alive; then
    if [ "$JSON_OUTPUT" -eq 1 ]; then
      printf '{"stopped":false,"running":false}\n'
    else
      printf 'tic80ctl: no active session\n'
    fi
    return 1
  fi

  PID="$(cat "$PID_FILE")"
  WRITER_PID="$(cat "$WRITER_PID_FILE" 2>/dev/null || true)"
  kill "$PID" 2>/dev/null || true
  if [ -n "$WRITER_PID" ]; then
    kill "$WRITER_PID" 2>/dev/null || true
    wait "$WRITER_PID" 2>/dev/null || true
  fi
  wait "$PID" 2>/dev/null || true
  rm -f "$PID_FILE" "$WRITER_PID_FILE" "$REQ_PIPE"

  if [ "$JSON_OUTPUT" -eq 1 ]; then
    printf '{"stopped":true,"pid":%s}\n' "$PID"
  else
    printf 'stopped tic80ctl session (pid=%s)\n' "$PID"
  fi
}

ensure_session() {
  if ! session_alive; then
    printf 'tic80ctl: no active session; run `tic80ctl start`\n' >&2
    exit 1
  fi
}

rpc_call() {
  METHOD="$1"
  PARAMS="$2"
  ensure_session

  ID="$$$(date +%s)"
  BEFORE_LINES="$(wc -l < "$OUT_LOG" 2>/dev/null || printf '0')"
  REQUEST="{\"jsonrpc\":\"2.0\",\"id\":$ID,\"method\":\"$METHOD\",\"params\":$PARAMS}"
  printf '%s\n' "$REQUEST" > "$REQ_PIPE"

  COUNT=0
  while [ "$COUNT" -lt 100 ]; do
    if ! session_alive; then
      printf 'tic80ctl: session terminated while waiting for response\n' >&2
      exit 1
    fi
    LINE="$(awk -v start="$((BEFORE_LINES + 1))" -v id="$ID" 'NR >= start && index($0, "\"id\":" id) {print; exit}' "$OUT_LOG" 2>/dev/null || true)"
    if [ -n "$LINE" ]; then
      printf '%s\n' "$LINE"
      return 0
    fi
    COUNT=$((COUNT + 1))
    sleep 0.1
  done

  printf 'tic80ctl: timed out waiting for MCP response\n' >&2
  exit 1
}

print_response() {
  LINE="$1"
  IS_ERROR="$(printf '%s\n' "$LINE" | sed -n 's/.*"isError":\(true\|false\).*/\1/p')"
  [ -n "$IS_ERROR" ] || IS_ERROR="false"

  if [ "$JSON_OUTPUT" -eq 1 ]; then
    COMMAND_NAME="${2:-}"
    if [ -n "$COMMAND_NAME" ]; then
      printf '%s\n' "$LINE" | jq -c --arg command "$COMMAND_NAME" '{command:$command,response:.}'
    else
      printf '%s\n' "$LINE"
    fi
  else
    TEXT="$(printf '%s\n' "$LINE" | extract_json_text)"
    if [ -n "$TEXT" ]; then
      printf '%s\n' "$TEXT"
    else
      printf '%s\n' "$LINE"
    fi
  fi

  if [ "$IS_ERROR" = "true" ]; then
    return 1
  fi
  return 0
}

tool_run_command() {
  COMMAND_TEXT="$1"
  ESCAPED="$(printf '%s' "$COMMAND_TEXT" | json_escape)"
  LINE="$(rpc_call "tools/call" "{\"name\":\"run_command\",\"arguments\":{\"command\":\"$ESCAPED\"}}")"
  print_response "$LINE" "run_command"
}

tool_capture_screenshot() {
  if [ $# -eq 0 ] || [ -z "${1:-}" ]; then
    LINE="$(rpc_call "tools/call" "{\"name\":\"capture_screenshot\",\"arguments\":{}}")"
  else
    ESCAPED="$(printf '%s' "$1" | json_escape)"
    LINE="$(rpc_call "tools/call" "{\"name\":\"capture_screenshot\",\"arguments\":{\"path\":\"$ESCAPED\"}}")"
  fi
  print_response "$LINE" "capture_screenshot"
}

tool_playtest() {
  SCRIPT_FILE=""
  TIMEOUT=""
  INPUT_OVERLAY="true"

  while [ $# -gt 0 ]; do
    case "$1" in
      --script-file)
        SCRIPT_FILE="${2:-}"
        shift 2
        ;;
      --timeout)
        TIMEOUT="${2:-}"
        shift 2
        ;;
      --input-overlay)
        INPUT_OVERLAY="true"
        shift
        ;;
      --no-input-overlay)
        INPUT_OVERLAY="false"
        shift
        ;;
      *)
        printf 'tic80ctl: unknown playtest option: %s\n' "$1" >&2
        exit 1
        ;;
    esac
  done

  [ -n "$SCRIPT_FILE" ] || { printf 'tic80ctl: --script-file is required\n' >&2; exit 1; }
  [ -f "$SCRIPT_FILE" ] || { printf 'tic80ctl: script file not found: %s\n' "$SCRIPT_FILE" >&2; exit 1; }

  SCRIPT_CONTENT="$(cat "$SCRIPT_FILE")"
  ESCAPED_SCRIPT="$(printf '%s' "$SCRIPT_CONTENT" | json_escape)"

  PARAMS="{\"name\":\"run_playtest_episode\",\"arguments\":{\"script\":\"$ESCAPED_SCRIPT\""
  if [ -n "$TIMEOUT" ]; then
    PARAMS="$PARAMS,\"timeout_seconds\":$TIMEOUT"
  fi
  PARAMS="$PARAMS,\"input_overlay\":$INPUT_OVERLAY}}"

  LINE="$(rpc_call "tools/call" "$PARAMS")"
  print_response "$LINE" "run_playtest_episode"
}

while [ $# -gt 0 ]; do
  case "$1" in
    --json)
      JSON_OUTPUT=1
      shift
      ;;
    *)
      break
      ;;
  esac
done

[ $# -gt 0 ] || { usage >&2; exit 1; }

SUBCOMMAND="$1"
shift

case "$SUBCOMMAND" in
  start)
    consume_json_flag "${1:-}" && shift
    start_session "${1:-}"
    ;;
  status)
    consume_json_flag "${1:-}" && shift
    status_session
    ;;
  stop)
    consume_json_flag "${1:-}" && shift
    stop_session
    ;;
  cmd)
    consume_json_flag "${1:-}" && shift
    [ $# -gt 0 ] || { printf 'tic80ctl: cmd requires a TIC-80 command string\n' >&2; exit 1; }
    tool_run_command "$1"
    ;;
  load)
    consume_json_flag "${1:-}" && shift
    [ $# -gt 0 ] || { printf 'tic80ctl: load requires a cart path\n' >&2; exit 1; }
    tool_run_command "load $1"
    ;;
  run)
    consume_json_flag "${1:-}" && shift
    tool_run_command "run"
    ;;
  eval)
    consume_json_flag "${1:-}" && shift
    [ $# -gt 0 ] || { printf 'tic80ctl: eval requires an expression\n' >&2; exit 1; }
    tool_run_command "eval $1"
    ;;
  screenshot)
    consume_json_flag "${1:-}" && shift
    tool_capture_screenshot "${1:-}"
    ;;
  playtest)
    consume_json_flag "${1:-}" && shift
    tool_playtest "$@"
    ;;
  *)
    usage >&2
    exit 1
    ;;
esac
